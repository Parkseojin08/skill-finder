{
  "name": "skill-finder",
  "version": "0.3.7",
  "private": true,
  "type": "module",
  "workspaces": ["server", "web"],
  "engines": { "node": ">=22.20" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @skill-finder/web",
    "start": "npm run build && npm start -w @skill-finder/server",
    "test": "npm test -w @skill-finder/server && npm test -w @skill-finder/web",
    "test:node": "npm run test:node -w @skill-finder/server && npm run test:node -w @skill-finder/web",
    "typecheck": "npm run typecheck -w @skill-finder/server && npm run typecheck -w @skill-finder/web && tsc --noEmit -p e2e && tsc --noEmit -p e2e/server",
    "lint": "oxlint",
    "knip": "knip",
    "e2e": "playwright test",
    "package": "node scripts/package-win.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "bun": "1.4.4",
    "knip": "6.43.0",
    "oxlint": "1.89.0"
  },
  "allowScripts": {
    "bun@1.4.4": true
  }
}
