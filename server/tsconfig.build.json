{
  // Compiles the server to JavaScript for the npm package (Node does not strip types under node_modules);
  // the app itself runs the TypeScript as it is. Used by scripts/pack-npm.mjs with --outDir.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "sourceMap": false,
    "declaration": false
  },
  "include": ["src"]
}
